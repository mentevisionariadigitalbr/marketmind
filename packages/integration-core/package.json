{
  "name": "@marketmind/integration-core",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"(lint via ESLint compartilhado na raiz)\"",
    "test": "jest"
  },
  "dependencies": {
    "@marketmind/kernel": "workspace:*",
    "@marketmind/queue": "workspace:*",
    "@marketmind/sdk-mercadolivre": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@prisma/client": "^6.2.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": ["reflect-metadata"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "collectCoverageFrom": ["**/*.ts", "!**/*.spec.ts", "!index.ts", "!**/__fixtures__/**"],
    "coverageDirectory": "../coverage"
  }
}
