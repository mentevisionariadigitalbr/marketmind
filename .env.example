# Copie para .env e ajuste conforme necessário.
# Banco (docker-compose expõe o Postgres na 5433 do host)
# DATABASE_URL: usada por migrations/Prisma CLI (role owner).
DATABASE_URL="postgresql://marketmind:marketmind@localhost:5433/marketmind?schema=public"
# APP_DATABASE_URL: usada pela API em runtime (role de menor privilégio, sujeita ao
# Row-Level Security — ADR-0002). A role marketmind_app é criada pela migration de RLS.
APP_DATABASE_URL="postgresql://marketmind_app:marketmind_app@localhost:5433/marketmind?schema=public"

# Redis (Sprint 2+) — exposto na 6380 do host
REDIS_URL="redis://localhost:6380"

# Auth
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# OAuth Google (opcional). Mesmo valor no front (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=""

# API
API_PORT=3333
CORS_ORIGIN="http://localhost:3000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3333"
# Mesmo client id do Google do backend (habilita o botão "Continuar com Google").
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
