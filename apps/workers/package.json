{
  "name": "@marketmind/workers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ts-node src/main.ts",
    "dev": "ts-node --transpile-only src/main.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"(lint via ESLint compartilhado na raiz)\"",
    "test": "jest",
    "test:int": "jest --config ./test/jest-int.json --runInBand"
  },
  "dependencies": {
    "@marketmind/queue": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "collectCoverageFrom": ["**/*.ts", "!**/*.spec.ts", "!main.ts", "!bootstrap/**", "!health/**"],
    "coverageDirectory": "../coverage"
  }
}
