// MarketMind AI — schema Prisma
// Fatia vertical (Sprint 1): tenancy + autenticação. As demais tabelas do
// docs/03-modelo-de-dados.md entram conforme as próximas fatias do Sprint 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

// Papel simplificado para a fatia inicial. O RBAC completo (roles/permissions
// como tabelas) entra na próxima fatia do Sprint 1 — ver ADR e doc 03.
enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  taxId     String?   @unique @map("tax_id")
  taxRegime TaxRegime @default(SIMPLES_NACIONAL) @map("tax_regime")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  users               User[]
  roles               Role[]
  marketplaceAccounts MarketplaceAccount[]
  subscription        Subscription?
  invoices            Invoice[]
  usageRecords        UsageRecord[]
  legalAcceptances    LegalAcceptance[]
  stockMovements      StockMovement[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  payables            Payable[]
  reportSubscription  ReportSubscription?

  @@map("companies")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  name         String
  email        String     @unique
  passwordHash String?    @map("password_hash")
  googleId     String?    @unique @map("google_id")
  role         UserRole   @default(OWNER)
  status       UserStatus @default(ACTIVE)
  // Convite por token (Fase 3): hash do token + validade. Limpos ao aceitar.
  inviteTokenHash String?  @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz(6)
  // Verificação de e-mail (Fase 4): nulo = não verificado. Não bloqueia o acesso.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]
  roleAssignments  UserRoleAssignment[]
  tokens           UserToken[]
  legalAcceptances LegalAcceptance[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?  @map("replaced_by_token_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum UserTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/**
 * Token de uso único (Fase 4): reset de senha e verificação de e-mail. Hash em
 * repouso, validade + used_at (invalidação após uso). Tenant via RLS por company.
 */
model UserToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  type      UserTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([companyId])
  @@map("user_tokens")
}

// ---------------------------------------------------------------------------
// RBAC — papéis e permissões (ADR-0002 / doc 03).
// `permissions` é um catálogo global (não tenant-scoped). `roles` podem ser de
// sistema (companyId = null, semeados) ou personalizados por empresa.
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // ex.: "finance:read"
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid // null = papel de sistema
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Auditoria — trilha imutável de ações (doc 06). Sem FKs para preservar o
// registro mesmo após exclusão de usuário/empresa. Tenant-scoped via RLS.
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String // ex.: "auth.login", "iam.role.assign"
  method     String
  path       String
  statusCode Int      @map("status_code")
  ip         String?
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Integração de Marketplace (Sprint 2) — doc 03 §2. Tokens criptografados em
// repouso. Idempotência de sync por UNIQUE(marketplace_account_id, external_id).
// ---------------------------------------------------------------------------

enum MarketplaceCode {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  MANUAL
}

enum MarketplaceAccountStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  UNKNOWN
}

/** Catálogo global de marketplaces suportados (não tenant-scoped). */
model Marketplace {
  id        String          @id @default(uuid()) @db.Uuid
  code      MarketplaceCode @unique
  name      String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  accounts MarketplaceAccount[]

  @@map("marketplaces")
}

model MarketplaceAccount {
  id              String                   @id @default(uuid()) @db.Uuid
  companyId       String                   @map("company_id") @db.Uuid
  marketplaceId   String                   @map("marketplace_id") @db.Uuid
  externalUserId  String                   @map("external_user_id")
  nickname        String?
  accessTokenEnc  String                   @map("access_token_enc")
  refreshTokenEnc String                   @map("refresh_token_enc")
  tokenExpiresAt  DateTime                 @map("token_expires_at") @db.Timestamptz(6)
  scope           String?
  status          MarketplaceAccountStatus @default(CONNECTED)
  lastSyncedAt    DateTime?                @map("last_synced_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  marketplace Marketplace @relation(fields: [marketplaceId], references: [id])
  products    Product[]
  orders      Order[]

  @@unique([companyId, marketplaceId, externalUserId])
  @@index([companyId])
  @@map("marketplace_accounts")
}

model Product {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  marketplaceAccountId String    @map("marketplace_account_id") @db.Uuid
  externalId           String    @map("external_id") // ex.: MLB123...
  sku                  String?
  title                String
  status               String
  price                Decimal?  @db.Decimal(14, 2)
  currency             String?
  availableQuantity    Int?      @map("available_quantity")
  categoryId           String?   @map("category_id")
  permalink            String?
  thumbnail            String?
  listingType          String?   @map("listing_type")
  supplierId           String?   @map("supplier_id") @db.Uuid
  // Campos manuais (Fase 2) — overrides internos; o sync do ML NUNCA os sobrescreve.
  brand                String?
  internalSku          String?   @map("internal_sku")
  internalTitle        String?   @map("internal_title")
  internalNotes        String?   @map("internal_notes")
  promoPrice           Decimal?  @map("promo_price") @db.Decimal(14, 2)
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  account            MarketplaceAccount  @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrderItems PurchaseOrderItem[]
  orderItems     OrderItem[]
  variants       ProductVariant[]
  images         ProductImage[]
  prices         ProductPrice[]
  inventory      Inventory[]
  costs          ProductCost[]
  stockMovements StockMovement[]

  @@unique([marketplaceAccountId, externalId])
  @@index([companyId])
  @@index([companyId, lastSyncedAt])
  @@map("products")
}

/** Variação de um anúncio (SKU/cor/tamanho/GTIN/atributos). Itens sem variação
 * têm uma variante sintética com external_id = id do item. */
model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  externalId        String   @map("external_id")
  sku               String?
  gtin              String? // EAN/GTIN
  color             String?
  size              String?
  price             Decimal? @db.Decimal(14, 2)
  availableQuantity Int?     @map("available_quantity")
  attributes        Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  costs     ProductCost[]

  @@unique([productId, externalId])
  @@index([companyId])
  @@map("product_variants")
}

/** Saldo de estoque por variante (1:1). Idempotente por variante. */
model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String   @unique @map("variant_id") @db.Uuid
  available Int      @default(0)
  reserved  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("inventory")
}

/** Histórico de preços (append-only; só grava quando o preço muda). */
model ProductPrice {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  amount     Decimal  @db.Decimal(14, 2)
  currency   String   @default("BRL")
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, capturedAt])
  @@map("product_prices")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  externalId String   @map("external_id") // picture id no ML
  url        String
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId])
  @@index([companyId])
  @@map("product_images")
}

/** Categorias do ML (catálogo global — não tenant-scoped). */
model Category {
  id               String   @id @default(uuid()) @db.Uuid
  externalId       String   @unique @map("external_id") // MLB...
  name             String
  parentExternalId String?  @map("parent_external_id")
  pathFromRoot     Json?    @map("path_from_root")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentExternalId])
  @@map("categories")
}

/** Closure table da árvore de categorias (consultas de subárvore rápidas). */
model CategoryTree {
  id                 String @id @default(uuid()) @db.Uuid
  ancestorExternalId String @map("ancestor_external_id")
  childExternalId    String @map("child_external_id")
  depth              Int

  @@unique([ancestorExternalId, childExternalId])
  @@index([childExternalId])
  @@map("category_tree")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  externalId String   @map("external_id")
  nickname   String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orders Order[]

  @@unique([companyId, externalId])
  @@index([companyId])
  @@map("customers")
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  companyId            String      @map("company_id") @db.Uuid
  marketplaceAccountId String      @map("marketplace_account_id") @db.Uuid
  customerId           String?     @map("customer_id") @db.Uuid
  externalId           String      @map("external_id")
  status               OrderStatus @default(UNKNOWN)
  currency             String      @default("BRL")
  grossAmount          Decimal     @default(0) @map("gross_amount") @db.Decimal(14, 2)
  freightAmount        Decimal     @default(0) @map("freight_amount") @db.Decimal(14, 2)
  commissionAmount     Decimal     @default(0) @map("commission_amount") @db.Decimal(14, 2)
  orderedAt            DateTime    @map("ordered_at") @db.Timestamptz(6)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  account  MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  customer Customer?          @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@unique([marketplaceAccountId, externalId])
  @@index([companyId, orderedAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  externalItemId String   @map("external_item_id")
  sku            String?
  title          String
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2)
  itemCommission Decimal  @default(0) @map("item_commission") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([orderId])
  @@map("order_items")
}

/**
 * Custo unitário por produto/variante com vigência por data (Fase 1 — Custos &
 * Lucratividade). Append-only por `valid_from`: um pedido usa o custo que valia
 * na sua data, preservando o COGS/lucro histórico. Custo unitário total =
 * acquisition + inboundFreight + packaging + other. Tenant-scoped via RLS.
 */
model ProductCost {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  variantId       String?   @map("variant_id") @db.Uuid
  sku             String?
  acquisitionCost Decimal   @default(0) @map("acquisition_cost") @db.Decimal(14, 2)
  inboundFreight  Decimal   @default(0) @map("inbound_freight") @db.Decimal(14, 2)
  packagingCost   Decimal   @default(0) @map("packaging_cost") @db.Decimal(14, 2)
  otherCost       Decimal   @default(0) @map("other_cost") @db.Decimal(14, 2)
  currency        String    @default("BRL")
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, productId, validFrom])
  @@index([companyId, variantId, validFrom])
  @@index([companyId, sku, validFrom])
  @@map("product_costs")
}

enum ExpenseKind {
  FIXED
  VARIABLE
}

enum ExpenseRecurrence {
  NONE
  MONTHLY
  YEARLY
}

/**
 * Despesa operacional (Fase 2 — DRE). Fixa ou variável, com recorrência opcional.
 * Recorrência mensal/anual é EXPANDIDA no período do DRE (uma linha "aluguel
 * mensal" conta em cada mês ativo de [starts_on, ends_on]). Tenant-scoped via RLS.
 */
model Expense {
  id         String            @id @default(uuid()) @db.Uuid
  companyId  String            @map("company_id") @db.Uuid
  category   String
  kind       ExpenseKind       @default(VARIABLE)
  amount     Decimal           @db.Decimal(14, 2)
  currency   String            @default("BRL")
  recurrence ExpenseRecurrence @default(NONE)
  startsOn   DateTime          @map("starts_on") @db.Timestamptz(6)
  endsOn     DateTime?         @map("ends_on") @db.Timestamptz(6)
  note       String?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId])
  @@index([companyId, startsOn])
  @@map("expenses")
}

/**
 * Regra de imposto (Fase 2 — DRE): alíquota efetiva por regime, opcionalmente por
 * categoria (`category` null = padrão do regime). Configurável pelo contador; o
 * motor puro (dashboard-core/tax.ts) resolve categoria → padrão → default. RLS.
 */
model TaxRule {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  regime    TaxRegime
  category  String? // null = padrão do regime
  rate      Decimal   @db.Decimal(6, 4) // fração 0..1 (ex.: 0.0600)
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, regime, category])
  @@index([companyId])
  @@map("tax_rules")
}

/** Idempotência de webhooks: a mesma notificação não é processada duas vezes. */
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  source      String // ex.: "mercado_livre"
  topic       String
  resource    String
  dedupeKey   String    @unique @map("dedupe_key")
  payload     Json
  status      String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([companyId, receivedAt])
  @@map("webhook_events")
}

/** Espelho persistente de jobs (centro de observabilidade) — ADR-0003. */
model Job {
  id         String    @id @default(uuid()) @db.Uuid
  queue      String
  jobName    String    @map("job_name")
  jobId      String?   @map("job_id") // id do job no broker (BullMQ)
  status     String    @default("pending") // pending|processing|completed|failed|dead_letter
  companyId  String?   @map("company_id") @db.Uuid
  payload    Json?
  attempts   Int       @default(0)
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs Int?      @map("duration_ms")
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([queue, jobId])
  @@index([queue, status])
  @@index([companyId])
  @@map("jobs")
}

// ─────────────────────────────── Cobrança (Fase 5) ───────────────────────────────

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum InvoiceStatus {
  PAID
  OPEN
  FAILED
  VOID
}

/** Catálogo global de planos (não tenant-scoped; semeado). Limite null = ilimitado. */
model Plan {
  id                     String   @id @default(uuid()) @db.Uuid
  code                   String   @unique // FREE | PRO | BUSINESS
  name                   String
  priceCents             Int      @map("price_cents")
  currency               String   @default("BRL")
  interval               String   @default("month") // month | year
  trialDays              Int      @default(14) @map("trial_days")
  maxMarketplaceAccounts Int?     @map("max_marketplace_accounts")
  maxProducts            Int?     @map("max_products")
  historyWindowDays      Int?     @map("history_window_days")
  stripePriceId          String?  @map("stripe_price_id")
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

/** Assinatura da empresa (1 por company). RLS por company. */
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  companyId              String             @unique @map("company_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  provider               String? // stripe | mercadopago | ...
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  trialStartedAt         DateTime?          @map("trial_started_at") @db.Timestamptz(6)
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([status])
  @@map("subscriptions")
}

/** Fatura emitida pelo provedor de pagamento. RLS por company. */
model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @map("company_id") @db.Uuid
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  provider          String
  providerInvoiceId String?       @unique @map("provider_invoice_id")
  amountCents       Int           @map("amount_cents")
  currency          String        @default("BRL")
  status            InvoiceStatus @default(OPEN)
  paymentMethod     String?       @map("payment_method") // card | pix | boleto
  hostedUrl         String?       @map("hosted_url")
  issuedAt          DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([companyId, issuedAt])
  @@map("invoices")
}

/** Registro de uso para limites por janela/métrica. RLS por company. */
model UsageRecord {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  metric     String // ex.: marketplace_accounts | products | ai_calls
  value      Int
  periodTag  String   @map("period_tag") // ex.: 2026-06 (mês de competência)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, metric, periodTag])
  @@map("usage_records")
}

// ─────────────────────────────── Legal & LGPD (Fase 6) ───────────────────────────────

enum LegalDocumentType {
  TERMS
  PRIVACY
}

/** Aceite versionado de documentos legais (prova de consentimento). RLS por company. */
model LegalAcceptance {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  documentType LegalDocumentType @map("document_type")
  version      String
  ip           String?
  userAgent    String?           @map("user_agent")
  acceptedAt   DateTime          @default(now()) @map("accepted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentType])
  @@index([companyId])
  @@map("legal_acceptances")
}

enum DataSubjectRequestType {
  EXPORT
  DELETION
}

enum DataSubjectRequestScope {
  USER
  COMPANY
}

/** Registro de pedidos de direitos do titular (LGPD): quem pediu, quando, tipo e
 *  escopo. Append-only (retido como prova). RLS por company. */
model DataSubjectRequest {
  id        String                  @id @default(uuid()) @db.Uuid
  companyId String                  @map("company_id") @db.Uuid
  userId    String                  @map("user_id") @db.Uuid
  type      DataSubjectRequestType
  scope     DataSubjectRequestScope
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt])
  @@map("data_subject_requests")
}

// ─────────────────────────── Admin de plataforma (Fase 7) ───────────────────────────

/**
 * Super-admin da PLATAFORMA (backoffice). Identidade SEPARADA do RBAC de tenant:
 * sem company_id, autenticado por um JWT de segredo próprio. Tabela global (sem RLS),
 * como o catálogo de planos/marketplaces — NÃO contém dados de cliente.
 */
model PlatformAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_admins")
}

// ─────────────────────────── Estoque operacional (Fase 1) ───────────────────────────

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  INVENTARIO
  DEVOLUCAO
}

/**
 * Razão de estoque (append-only) para rastreabilidade/conciliação. O ML continua
 * mestre do `available` do anúncio; aqui registramos ajustes/inventário/entradas e
 * mostramos divergência. `quantity` é sinalizado (+entrada / −saída). RLS por company.
 */
model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  variantId     String?           @map("variant_id") @db.Uuid
  type          StockMovementType
  quantity      Int
  balanceAfter  Int               @map("balance_after")
  unitCost      Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  reason        String?
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id") @db.Uuid
  occurredAt    DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdBy     String?           @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, occurredAt])
  @@map("stock_movements")
}

/**
 * Fornecedor (Fase 1, Inc.2). RLS por company. `leadTimeDays` alimenta a previsão
 * de reposição (Inc.3) e o vínculo com produtos habilita o relatório por fornecedor.
 */
model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  contactName     String?  @map("contact_name")
  phone           String?
  email           String?
  document        String?
  leadTimeDays    Int?     @map("lead_time_days")
  paymentTermDays Int?     @map("payment_term_days")
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products       Product[]
  purchaseOrders PurchaseOrder[]
  payables       Payable[]

  @@index([companyId, active])
  @@map("suppliers")
}

enum PayableStatus {
  PENDING
  PAID
}

enum ReportFrequency {
  DAILY
  WEEKLY
}

/** Assinatura de relatório por e-mail (Fase 3, Inc.3). Uma por empresa. */
model ReportSubscription {
  id         String          @id @default(uuid()) @db.Uuid
  companyId  String          @unique @map("company_id") @db.Uuid
  frequency  ReportFrequency @default(WEEKLY)
  recipients String
  enabled    Boolean         @default(false)
  lastSentAt DateTime?       @map("last_sent_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("report_subscriptions")
}

/**
 * Conta a pagar (Fase 3, Inc.1). Gerada no recebimento de uma compra (vencimento =
 * recebimento + prazo do fornecedor) ou lançada manualmente. Alimenta o fluxo de caixa.
 */
model Payable {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  supplierId  String?       @map("supplier_id") @db.Uuid
  sourceType  String        @map("source_type")
  sourceId    String?       @map("source_id") @db.Uuid
  description String?
  amount      Decimal       @db.Decimal(14, 2)
  dueDate     DateTime      @map("due_date") @db.Timestamptz(6)
  status      PayableStatus @default(PENDING)
  paidAt      DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([companyId, status, dueDate])
  @@map("payables")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

/**
 * Pedido de compra (Fase 1, Inc.4). Ao receber: gera ENTRADA no razão de estoque e
 * atualiza o custo do produto por média ponderada. RLS por company.
 */
model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  companyId  String              @map("company_id") @db.Uuid
  supplierId String?             @map("supplier_id") @db.Uuid
  status     PurchaseOrderStatus @default(DRAFT)
  notes      String?
  expectedAt DateTime?           @map("expected_at") @db.Timestamptz(6)
  receivedAt DateTime?           @map("received_at") @db.Timestamptz(6)
  createdBy  String?             @map("created_by") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseOrderItem[]

  @@index([companyId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantity         Int
  unitCost         Decimal  @map("unit_cost") @db.Decimal(14, 2)
  receivedQuantity Int      @default(0) @map("received_quantity")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, purchaseOrderId])
  @@map("purchase_order_items")
}
