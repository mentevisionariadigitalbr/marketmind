// MarketMind AI — schema Prisma
// Fatia vertical (Sprint 1): tenancy + autenticação. As demais tabelas do
// docs/03-modelo-de-dados.md entram conforme as próximas fatias do Sprint 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

// Papel simplificado para a fatia inicial. O RBAC completo (roles/permissions
// como tabelas) entra na próxima fatia do Sprint 1 — ver ADR e doc 03.
enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  taxId     String?   @unique @map("tax_id")
  taxRegime TaxRegime @default(SIMPLES_NACIONAL) @map("tax_regime")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  users               User[]
  roles               Role[]
  marketplaceAccounts MarketplaceAccount[]

  @@map("companies")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  name         String
  email        String     @unique
  passwordHash String?    @map("password_hash")
  googleId     String?    @unique @map("google_id")
  role         UserRole   @default(OWNER)
  status       UserStatus @default(ACTIVE)
  // Convite por token (Fase 3): hash do token + validade. Limpos ao aceitar.
  inviteTokenHash String?  @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]
  roleAssignments UserRoleAssignment[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?  @map("replaced_by_token_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// RBAC — papéis e permissões (ADR-0002 / doc 03).
// `permissions` é um catálogo global (não tenant-scoped). `roles` podem ser de
// sistema (companyId = null, semeados) ou personalizados por empresa.
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // ex.: "finance:read"
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid // null = papel de sistema
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Auditoria — trilha imutável de ações (doc 06). Sem FKs para preservar o
// registro mesmo após exclusão de usuário/empresa. Tenant-scoped via RLS.
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String // ex.: "auth.login", "iam.role.assign"
  method     String
  path       String
  statusCode Int      @map("status_code")
  ip         String?
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Integração de Marketplace (Sprint 2) — doc 03 §2. Tokens criptografados em
// repouso. Idempotência de sync por UNIQUE(marketplace_account_id, external_id).
// ---------------------------------------------------------------------------

enum MarketplaceCode {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
}

enum MarketplaceAccountStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  UNKNOWN
}

/** Catálogo global de marketplaces suportados (não tenant-scoped). */
model Marketplace {
  id        String          @id @default(uuid()) @db.Uuid
  code      MarketplaceCode @unique
  name      String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  accounts MarketplaceAccount[]

  @@map("marketplaces")
}

model MarketplaceAccount {
  id              String                   @id @default(uuid()) @db.Uuid
  companyId       String                   @map("company_id") @db.Uuid
  marketplaceId   String                   @map("marketplace_id") @db.Uuid
  externalUserId  String                   @map("external_user_id")
  nickname        String?
  accessTokenEnc  String                   @map("access_token_enc")
  refreshTokenEnc String                   @map("refresh_token_enc")
  tokenExpiresAt  DateTime                 @map("token_expires_at") @db.Timestamptz(6)
  scope           String?
  status          MarketplaceAccountStatus @default(CONNECTED)
  lastSyncedAt    DateTime?                @map("last_synced_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  marketplace Marketplace @relation(fields: [marketplaceId], references: [id])
  products    Product[]
  orders      Order[]

  @@unique([companyId, marketplaceId, externalUserId])
  @@index([companyId])
  @@map("marketplace_accounts")
}

model Product {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  marketplaceAccountId String    @map("marketplace_account_id") @db.Uuid
  externalId           String    @map("external_id") // ex.: MLB123...
  sku                  String?
  title                String
  status               String
  price                Decimal?  @db.Decimal(14, 2)
  currency             String?
  availableQuantity    Int?      @map("available_quantity")
  categoryId           String?   @map("category_id")
  permalink            String?
  thumbnail            String?
  listingType          String?   @map("listing_type")
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  account    MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  variants   ProductVariant[]
  images     ProductImage[]
  prices     ProductPrice[]
  inventory  Inventory[]
  costs      ProductCost[]

  @@unique([marketplaceAccountId, externalId])
  @@index([companyId])
  @@index([companyId, lastSyncedAt])
  @@map("products")
}

/** Variação de um anúncio (SKU/cor/tamanho/GTIN/atributos). Itens sem variação
 * têm uma variante sintética com external_id = id do item. */
model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  externalId        String   @map("external_id")
  sku               String?
  gtin              String? // EAN/GTIN
  color             String?
  size              String?
  price             Decimal? @db.Decimal(14, 2)
  availableQuantity Int?     @map("available_quantity")
  attributes        Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  costs     ProductCost[]

  @@unique([productId, externalId])
  @@index([companyId])
  @@map("product_variants")
}

/** Saldo de estoque por variante (1:1). Idempotente por variante. */
model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String   @unique @map("variant_id") @db.Uuid
  available Int      @default(0)
  reserved  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("inventory")
}

/** Histórico de preços (append-only; só grava quando o preço muda). */
model ProductPrice {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  amount     Decimal  @db.Decimal(14, 2)
  currency   String   @default("BRL")
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, capturedAt])
  @@map("product_prices")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  externalId String   @map("external_id") // picture id no ML
  url        String
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId])
  @@index([companyId])
  @@map("product_images")
}

/** Categorias do ML (catálogo global — não tenant-scoped). */
model Category {
  id               String   @id @default(uuid()) @db.Uuid
  externalId       String   @unique @map("external_id") // MLB...
  name             String
  parentExternalId String?  @map("parent_external_id")
  pathFromRoot     Json?    @map("path_from_root")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentExternalId])
  @@map("categories")
}

/** Closure table da árvore de categorias (consultas de subárvore rápidas). */
model CategoryTree {
  id                 String @id @default(uuid()) @db.Uuid
  ancestorExternalId String @map("ancestor_external_id")
  childExternalId    String @map("child_external_id")
  depth              Int

  @@unique([ancestorExternalId, childExternalId])
  @@index([childExternalId])
  @@map("category_tree")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  externalId String   @map("external_id")
  nickname   String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orders Order[]

  @@unique([companyId, externalId])
  @@index([companyId])
  @@map("customers")
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  companyId            String      @map("company_id") @db.Uuid
  marketplaceAccountId String      @map("marketplace_account_id") @db.Uuid
  customerId           String?     @map("customer_id") @db.Uuid
  externalId           String      @map("external_id")
  status               OrderStatus @default(UNKNOWN)
  currency             String      @default("BRL")
  grossAmount          Decimal     @default(0) @map("gross_amount") @db.Decimal(14, 2)
  freightAmount        Decimal     @default(0) @map("freight_amount") @db.Decimal(14, 2)
  commissionAmount     Decimal     @default(0) @map("commission_amount") @db.Decimal(14, 2)
  orderedAt            DateTime    @map("ordered_at") @db.Timestamptz(6)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  account  MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  customer Customer?          @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@unique([marketplaceAccountId, externalId])
  @@index([companyId, orderedAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  externalItemId String   @map("external_item_id")
  sku            String?
  title          String
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2)
  itemCommission Decimal  @default(0) @map("item_commission") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([orderId])
  @@map("order_items")
}

/**
 * Custo unitário por produto/variante com vigência por data (Fase 1 — Custos &
 * Lucratividade). Append-only por `valid_from`: um pedido usa o custo que valia
 * na sua data, preservando o COGS/lucro histórico. Custo unitário total =
 * acquisition + inboundFreight + packaging + other. Tenant-scoped via RLS.
 */
model ProductCost {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  variantId       String?   @map("variant_id") @db.Uuid
  sku             String?
  acquisitionCost Decimal   @default(0) @map("acquisition_cost") @db.Decimal(14, 2)
  inboundFreight  Decimal   @default(0) @map("inbound_freight") @db.Decimal(14, 2)
  packagingCost   Decimal   @default(0) @map("packaging_cost") @db.Decimal(14, 2)
  otherCost       Decimal   @default(0) @map("other_cost") @db.Decimal(14, 2)
  currency        String    @default("BRL")
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, productId, validFrom])
  @@index([companyId, variantId, validFrom])
  @@index([companyId, sku, validFrom])
  @@map("product_costs")
}

enum ExpenseKind {
  FIXED
  VARIABLE
}

enum ExpenseRecurrence {
  NONE
  MONTHLY
  YEARLY
}

/**
 * Despesa operacional (Fase 2 — DRE). Fixa ou variável, com recorrência opcional.
 * Recorrência mensal/anual é EXPANDIDA no período do DRE (uma linha "aluguel
 * mensal" conta em cada mês ativo de [starts_on, ends_on]). Tenant-scoped via RLS.
 */
model Expense {
  id         String            @id @default(uuid()) @db.Uuid
  companyId  String            @map("company_id") @db.Uuid
  category   String
  kind       ExpenseKind       @default(VARIABLE)
  amount     Decimal           @db.Decimal(14, 2)
  currency   String            @default("BRL")
  recurrence ExpenseRecurrence @default(NONE)
  startsOn   DateTime          @map("starts_on") @db.Timestamptz(6)
  endsOn     DateTime?         @map("ends_on") @db.Timestamptz(6)
  note       String?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId])
  @@index([companyId, startsOn])
  @@map("expenses")
}

/**
 * Regra de imposto (Fase 2 — DRE): alíquota efetiva por regime, opcionalmente por
 * categoria (`category` null = padrão do regime). Configurável pelo contador; o
 * motor puro (dashboard-core/tax.ts) resolve categoria → padrão → default. RLS.
 */
model TaxRule {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  regime    TaxRegime
  category  String? // null = padrão do regime
  rate      Decimal   @db.Decimal(6, 4) // fração 0..1 (ex.: 0.0600)
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, regime, category])
  @@index([companyId])
  @@map("tax_rules")
}

/** Idempotência de webhooks: a mesma notificação não é processada duas vezes. */
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  source      String // ex.: "mercado_livre"
  topic       String
  resource    String
  dedupeKey   String    @unique @map("dedupe_key")
  payload     Json
  status      String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([companyId, receivedAt])
  @@map("webhook_events")
}

/** Espelho persistente de jobs (centro de observabilidade) — ADR-0003. */
model Job {
  id         String    @id @default(uuid()) @db.Uuid
  queue      String
  jobName    String    @map("job_name")
  jobId      String?   @map("job_id") // id do job no broker (BullMQ)
  status     String    @default("pending") // pending|processing|completed|failed|dead_letter
  companyId  String?   @map("company_id") @db.Uuid
  payload    Json?
  attempts   Int       @default(0)
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs Int?      @map("duration_ms")
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([queue, jobId])
  @@index([queue, status])
  @@index([companyId])
  @@map("jobs")
}
