# ── MarketMind API — variáveis de ambiente (template; NÃO commitar segredos reais) ──

NODE_ENV=production

# Banco (Supabase). Owner/migrations = DATABASE_URL; runtime (RLS) = APP_DATABASE_URL.
# Em produção gerenciada, ambos podem apontar para a mesma URL do Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public&sslmode=require"
APP_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public&sslmode=require"

# Redis (Upstash) — cache do dashboard + filas BullMQ. TLS: use rediss://
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

# JWT (mín. 16 chars cada). Gere com: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret-32-bytes-min"
JWT_REFRESH_SECRET="change-me-refresh-secret-32-bytes-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Cifra dos tokens de marketplace em repouso (mín. 16 chars). openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="change-me-token-encryption-key-32b"

# HTTP
API_PORT=3333
CORS_ORIGIN="https://SEU-FRONT.vercel.app"

# Rate limiting (Sprint 3.2) — limite global por IP (rotas têm limites próprios).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# /metrics: se definido, exige `Authorization: Bearer <token>` de fora da rede interna.
METRICS_TOKEN="change-me-or-leave-empty-for-loopback-only"

# E-mail transacional (Resend). Sem RESEND_API_KEY o app usa um sender "noop"
# (apenas loga) — bom para dev. EMAIL_FROM precisa ser um remetente verificado.
RESEND_API_KEY=""
EMAIL_FROM="MarketMind AI <no-reply@seu-dominio.com>"

# Cobrança Stripe (Fase 5). Sem STRIPE_SECRET_KEY o app sobe, mas checkout/portal
# ficam indisponíveis (NoopPaymentProvider). Use test mode no dev (sk_test_...).
# Os price IDs (test mode) de cada plano são semeados em `plans` pelo seed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# OAuth Google (opcional)
GOOGLE_CLIENT_ID=""

# Mercado Livre (opcional até configurar o app no painel do ML)
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="https://SEU-BACK.up.railway.app/integrations/mercado-livre/callback"
