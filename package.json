{
  "name": "marketmind-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres redis",
    "db:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "overrides": {
      "multer@>=1.0.0 <2.2.0": "2.2.0",
      "postcss@<8.5.10": ">=8.5.10",
      "js-yaml@<=4.1.1": ">=4.2.0"
    }
  }
}
